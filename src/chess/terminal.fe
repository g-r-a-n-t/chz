}

#[test]
fn test_terminal_dead_position_bishops_same_color_only() {
    // K+B vs K+B with bishops on the same color squares should be dead.
    let mut board: u256 = 0
    board = set_piece(board, 4, PIECE_WK) // e1
    board = set_piece(board, 2, PIECE_WB) // c1 (dark)
    board = set_piece(board, 60, PIECE_BK) // e8
    board = set_piece(board, 61, PIECE_BB) // f8 (dark)
    let meta = meta_custom(
        stm_white: true,
        rights: 0,
        ep_file: EP_NONE,
        halfmove: 0,
        fullmove: 1,
        wk: 4,
        bk: 60,
    )
    let (s, r) = classify_terminal_state(board, meta)
    match (s, r) {
        (GameStatus::Draw, EndReason::DeadPosition) => {}
        _ => assert(false)
    }

    // Opposite-colored bishops: not an automatic dead position.
    let mut board2: u256 = 0
    board2 = set_piece(board2, 4, PIECE_WK) // e1
    board2 = set_piece(board2, 2, PIECE_WB) // c1 (dark)
    board2 = set_piece(board2, 60, PIECE_BK) // e8
    board2 = set_piece(board2, 58, PIECE_BB) // c8 (light)
    let meta2 = meta_custom(
        stm_white: true,
        rights: 0,
        ep_file: EP_NONE,
        halfmove: 0,
        fullmove: 1,
        wk: 4,
        bk: 60,
    )
    let (s2, r2) = classify_terminal_state(board2, meta2)
    match (s2, r2) {
        (GameStatus::Ongoing, EndReason::None) => {}
        _ => assert(false)
    }
}
