        fullmove: 1,
        wk: 41,
        bk: 56,
    )
    let (s, r) = classify_terminal_state(board, meta)
    match (s, r) {
        (GameStatus::WhiteWon, EndReason::Checkmate) => {}
        _ => assert(false)
